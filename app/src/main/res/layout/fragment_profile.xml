<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Мой профиль"
        android:textSize="24sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/imageViewProfilePhoto"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:src="@android:drawable/sym_def_app_icon"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя:"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/editTextProfileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите ваше имя"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Цели знакомства:"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/editTextDatingGoals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Опишите ваши цели"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Описание:"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/editTextProfileDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Напишите о себе"
        android:minLines="3"
        android:gravity="top"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textViewCrystalBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Кристаллы: 0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/buttonSaveProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сохранить профиль"
        android:layout_gravity="center_horizontal"/>

</LinearLayout>

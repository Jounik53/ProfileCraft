<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <!-- Корневой макет для содержимого карточки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- TextView для отображения текста описания профиля -->
        <TextView
            android:id="@+id/text_description_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пример сгенерированного описания профиля..."
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp"/>

        <!-- Кнопка для добавления описания к своему профилю -->
        <Button
            android:id="@+id/button_add_to_yours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить к своим"
            android:layout_gravity="end"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
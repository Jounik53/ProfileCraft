<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Установка типа проекта как тестовой библиотеки -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Используем NUnit как тестовый фреймворк -->
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />

    <!-- Пакет для создания Mock-объектов -->
    <PackageReference Include="NSubstitute" Version="5.1.0" />

    <!-- Пакет для написания утверждений в стиле Should -->
    <PackageReference Include="Shouldly" Version="4.2.1" />

    <!-- Пакет для покрытия кода (опционально) -->
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ссылка на проект Application, который будем тестировать -->
    <ProjectReference Include="..\..\src\MyDatingProfileHelper.Backend.Application\MyDatingProfileHelper.Backend.Application.csproj" />
  </ItemGroup>

</Project>

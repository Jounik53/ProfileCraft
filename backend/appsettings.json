{
  // Настройки подключения к базам данных
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mydatingprofilehelper_db;Username=myuser;Password=mypassword" // Placeholder для строки подключения к PostgreSQL
  },

  // Настройки для JWT аутентификации
  "JwtSettings": {
    "Secret": "СекретныйКлючДляПодписиJWTТокенов_ДлинныйИНадежный", // Секретный ключ для подписи JWT. Должен быть достаточно длинным и храниться безопасно.
    "Issuer": "MyDatingProfileHelper.Backend", // Издатель токена
    "Audience": "MyDatingProfileHelper.App" // Аудитория токена (кто его использует)
  },

  // Настройки для Google API (например, для верификации токенов Google Sign-In)
  "GoogleApiSettings": {
    "ClientId": "ВАШ_GOOGLE_CLIENT_ID.apps.googleusercontent.com" // Client ID вашего приложения Google
  },

  // Настройки логирования
  "Logging": {
    "LogLevel": { // Уровни логирования
      "Default": "Information", // Уровень по умолчанию
      "Microsoft.AspNetCore": "Warning" // Уровень для ASP.NET Core фреймворка
    }
  },

  // Настройки для запуска приложения
  "AllowedHosts": "*" // Разрешенные хосты (для продакшена следует ограничить)
}
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Версия приложения -->
    <Version>1.0.0</Version> 
  </PropertyGroup>

  <ItemGroup>
    <!-- Ссылка на проект Domain -->
    <ProjectReference Include="..\MyDatingProfileHelper.Backend.Domain\MyDatingProfileHelper.Backend.Domain.csproj" />
    <!-- Ссылка на проект Application -->
    <ProjectReference Include="..\MyDatingProfileHelper.Backend.Application\MyDatingProfileHelper.Backend.Application.csproj" />
    <!-- Ссылка на проект Infrastructure.PostgreSQL -->
    <ProjectReference Include="..\MyDatingProfileHelper.Backend.Infrastructure.PostgreSQL\MyDatingProfileHelper.Backend.Infrastructure.PostgreSQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Пакеты для ASP.NET Core -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <!-- Пакеты для Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <!-- Пакеты для Swagger/OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <!-- Пакет MediatR -->
    <PackageReference Include="MediatR" Version="12.2.0" />
  </ItemGroup>

</Project>